# Names and IPs agents use to reach this server. They go into the agent TLS certificate;
# the first one is used to build the agent URL. Changing this re-issues the certificate.
HOMEXDR_SERVER_NAMES=homexdr.lan,192.168.1.50

# Override when agents reach the server through a different host/port (NAT, proxy).
HOMEXDR_AGENT_URL=

# ClickHouse password (letters and digits only; it is embedded in a URL).
CLICKHOUSE_PASSWORD=change-me-to-a-long-random-string

# Days of telemetry to keep.
HOMEXDR_RETENTION_DAYS=30

# Set to true when the console is served over HTTPS (e.g. behind a reverse proxy).
HOMEXDR_SECURE_COOKIES=false

# Comma-separated IPs/CIDRs allowed to send syslog (empty = anyone who can reach the port).
# Example: your OPNsense LAN address.
HOMEXDR_SYSLOG_ALLOW=

# Published host ports.
HOMEXDR_CONSOLE_PORT=8080
HOMEXDR_AGENT_PORT=8443
HOMEXDR_SYSLOG_PORT=514
